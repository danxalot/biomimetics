import os
import logging
from mcp.server.fastmcp import FastMCP

# Initialize FastMCP
mcp = FastMCP("mcp-skill-forge")
logger = logging.getLogger(__name__)

TOOLS_DIR = "/app/skills"

@mcp.tool()
def forge_new_skill(filename: str, code_content: str, dependencies: list[str] = None) -> str:
    """
    Creates a new MCP tool python file. Use this when you identify a repeatable pattern that should be automated.
    
    Args:
        filename: The name of the file to create (e.g., mcp_docker_cleanup.py).
        code_content: The complete Python code for the tool, including imports and error handling.
        dependencies: A list of Python packages required by the tool.
    """
    try:
        # Ensure filename ends with .py
        if not filename.endswith(".py"):
            filename += ".py"
            
        # Security check: prevent directory traversal
        if ".." in filename or "/" in filename or "\\" in filename:
            return "Error: Filename cannot contain path separators. Tools are created in the default tools directory."

        logger.info(f"DEBUG: forge_new_skill called for {filename}")
        logger.info(f"DEBUG: TOOLS_DIR is {TOOLS_DIR}")

        file_path = os.path.join(TOOLS_DIR, filename)
        logger.info(f"DEBUG: Target file path is {file_path}")
        
        if os.path.exists(file_path):
            return f"Error: File '{filename}' already exists. Please choose a different name or use a modification tool."

        # Write the code content
        with open(file_path, "w") as f:
            f.write(code_content)
            
        response = f"Successfully created tool '{filename}' at {file_path} (Absolute: {os.path.abspath(file_path)})."
        
        if dependencies:
            response += f"\n\nNote: The following dependencies were requested: {', '.join(dependencies)}."
            response += "\nPlease ensure these are installed in the environment or added to requirements.txt."
            
        return response

    except Exception as e:
        logger.error(f"Failed to forge skill: {e}")
        return f"Error creating tool: {str(e)}"
