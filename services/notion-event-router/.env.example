# Phase 1: Notion Event Router - Environment Variables

# Copy this file to .dev.vars for local development
# NEVER commit .dev.vars to git!

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC_ID=os-events

# GitHub Configuration
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-target-repository

# Notion Configuration
NOTION_WEBHOOK_SECRET=your-notion-webhook-secret

# Secrets (set via `wrangler secret put` in production)
# These are NOT in this file - use wrangler CLI:
#   wrangler secret put GITHUB_PAT
#   wrangler secret put GCP_SERVICE_ACCOUNT_JSON
#   wrangler secret put NOTION_WEBHOOK_SECRET
