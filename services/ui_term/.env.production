# Environment Configuration for GCP Deployment

# CRITICAL: Point to OCI agent_service
# Replace with actual OCI public IP
AGENT_SERVICE_URL=http://141.147.85.137:8000

# Service port (default: 8084)
USER_AGENT_PORT=8084

# MCP Server URL (if available)
MCP_SERVER_URL=http://localhost:8085

# MiniMax API Key (load from secrets)
# Will be loaded from /app/.secrets/MINIMAX_API_KEY.json if mounted
# Or set directly here:
# ARCA_MiniMax=your_minimax_api_key_here
