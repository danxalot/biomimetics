- Compressor: gemini-2.5-flash (MCP tool)
"""

import os
from dataclasses import dataclass, field
from typing import Dict, Optional, List
from datetime import datetime


@dataclass
class ModelConfig:
    """Configuration for a single model"""
    name: str
    provider: str  # 'google', 'local', 'openai', etc.
    tier: int  # 1=fast/cheap, 2=balanced, 3=powerful/expensive
    description: str
    role: Optional[str] = None  # 'architect', 'engineer', 'orchestrator', 'deepthink', etc.
    context_window: int = 0
    latency_ms: int = 0
    quota_tracked: bool = False  # Track API quota usage
    endpoint: Optional[str] = None
    container_endpoint: Optional[str] = None


@dataclass
class QuotaCounter:
    """Tracks quota usage for API calls"""
    model_name: str
    role: str
    calls_count: int = 0
    tokens_used: int = 0
    quota_limit: int = 0
    quota_remaining: int = 0
    last_updated: str = field(default_factory=lambda: datetime.now().isoformat())
    
    def increment_call(self, tokens: int = 0):
        """Increment call counter"""
        self.calls_count += 1
        self.tokens_used += tokens
        self.quota_remaining = max(0, self.quota_limit - self.tokens_used)
        self.last_updated = datetime.now().isoformat()


