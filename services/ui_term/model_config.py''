def get_model(key: str) -> str:
    """
    Get model name from environment or default.
    
    Usage:
        from model_config import get_model
        model_name = get_model("CHAT_MODEL")
    """
    env_key = f"ARCA_{key}"
    return os.environ.get(env_key, DEFAULTS.get(key, ""))


def get_all_models() -> Dict[str, str]:
    """Get all configured model names"""
    return {key: get_model(key) for key in DEFAULTS.keys()}


