        "gemini-2.5-pro": {"provider": "google", "context_window": 2097152, "supports_function_calling": True, "input_cost": 0.00125, "output_cost": 0.005, "model_alias": "gemini-2.5-pro"},
        "gemini-pro-latest": {"provider": "google", "context_window": 2097152, "supports_function_calling": True, "input_cost": 0.00125, "output_cost": 0.005, "model_alias": "gemini-pro-latest"},
    }

    # Cloud Models (Added Dec 2025)
    # Cloud Models (Added Dec 2025) - GLM Only
    cloud_models = {
        "glm-4.6v-flash": {"provider": "zhipu", "context_window": 200000, "supports_function_calling": True, "input_cost": 0.0001, "output_cost": 0.0001, "model_alias": "glm-4v-flash"},
        "glm-4.7": {"provider": "zhipu", "context_window": 200000, "supports_function_calling": True, "input_cost": 0.005, "output_cost": 0.015, "model_alias": "glm-4.7"},
    }
    
    # Merge configurations
    all_configs = {**base_configs, **google_models, **cloud_models}
    
    # Add any additional models from AVAILABLE_MODELS if available
    if MODEL_CONFIG_AVAILABLE and AVAILABLE_MODELS:
        for model_name, model_info in AVAILABLE_MODELS.items():
            if model_name not in all_configs:
                # Detect local models by cost field
                is_local = model_info.get("cost") == "local"
                provider = "local" if is_local else model_info.get("provider", "google")
                
                all_configs[model_name] = {
                    "provider": provider,
                    "context_window": model_info.get("context", 8192 if is_local else 1048576),
                    "supports_function_calling": not is_local,  # Local models don't support function calling
                    "input_cost": 0.0,
                    "output_cost": 0.0,
                    "model_alias": model_info.get("litellm_model_name", model_name),
                    # Local models route to native llama server
                    "api_base": f"http://{os.environ.get('LOCAL_LLM_HOST', 'host.docker.internal')}:11434/v1" if is_local else None
                }
    
    return all_configs

# Load Rotation Map from enriched model info
ROTATION_MAP = {}
try:
    with open("../../mcp_skills/model_info_latest.json", "r") as f:
        info_data = json.load(f)
        for m in info_data:
            # removing 'models/' prefix for matching if needed, or keeping if config uses it
            # The gateway config usually uses short names or whatever is in AVAILABLE_MODELS
            # Let's map both to be safe
            name = m.get("name", "")
            short_name = name.replace("models/", "")
            next_model = m.get("rotationPath")
            
            if next_model:
                ROTATION_MAP[name] = next_model
                ROTATION_MAP[short_name] = next_model.replace("models/", "")

    logger.info(f"Loaded Rotation Map with {len(ROTATION_MAP)} entries")
except Exception as e:
    logger.warning(f"Failed to load Rotation Map: {e}")

# Dynamic MODEL_CONFIGS - regenerated on startup and model config changes
MODEL_CONFIGS = get_model_configs()

async def resolve_model_with_rotation(requested_model: str) -> str:
    """
    Check quota for model. If exceeded, rotate to next in chain.
    Returns the first available model name, or raises HTTPException if all exhausted.
    """
    candidate = requested_model
    visited = set()
    
    while candidate:
        if candidate in visited:
            break # Cycle detected
        visited.add(candidate)
        
        # Check if we have config for this candidate (sanity check)
        # If it's a dynamic Google model, it might not be in MODEL_CONFIGS keys explicitly if simple dict
        # but we trust the rotation map offers valid options.
        
        allowed = await check_rate_limits(candidate)
        if allowed:
            if candidate != requested_model:
                logger.info(f"🔄 Rotating model: {requested_model} -> {candidate} (Quota Exceeded)")
            return candidate
            
        # Quota exceeded, look for next
        next_candidate = ROTATION_MAP.get(candidate)
        if not next_candidate:
            # specific logic: aliases might map to full names in rotation map
             # e.g. gemini-3-pro-preview -> models/gemini-3-pro-preview
             pass

        if not next_candidate:
             logger.warning(f"❌ Model {candidate} exhausted and no rotation path defined.")
             raise HTTPException(status_code=429, detail=f"Quota exceeded for {requested_model} and no fallbacks available.")
             
        candidate = next_candidate
        
    raise HTTPException(status_code=429, detail=f"All models in rotation chain exhausted for {requested_model}")

@app.get("/health")
async def health_check():
    """Health check endpoint"""
    health_status = {
        "status": "healthy",
        "timestamp": datetime.utcnow().isoformat(),
        "redis_connected": redis_client is not None
    }

    # Check Redis connection if available
    if redis_client:
        try:
            await redis_client.ping()
            health_status["redis_status"] = "connected"
        except Exception as e:
            health_status["redis_status"] = f"error: {str(e)}"
            health_status["status"] = "degraded"
    else:
        health_status["redis_status"] = "not configured"

    return health_status

@app.get("/models", response_model=List[ModelInfo])
async def list_models():
    """List available models"""
    models = []
    for model_name, config in MODEL_CONFIGS.items():
        models.append(ModelInfo(
            name=model_name,
            provider=config["provider"],
            context_window=config["context_window"],
            supports_function_calling=config["supports_function_calling"],
            input_cost_per_token=config["input_cost"],
            output_cost_per_token=config["output_cost"]
        ))
    return models

async def handle_cohere_chat_completion(body: ChatCompletionRequest, request: Request):
    """Handle Cohere chat completion with direct API calls"""
    try:
        import httpx
        print(f"DEBUG: Starting Cohere request for model {body.model}", flush=True)
    except ImportError:
        raise HTTPException(status_code=500, detail="httpx not available")

    cohere_key = os.getenv("COHERE_API_KEY")
    if not cohere_key:
        raise HTTPException(status_code=500, detail="Cohere API key not configured")

    # Convert OpenAI format to Cohere format
    # Cohere expects a single message string, not an array
    if not body.messages:
        raise HTTPException(status_code=400, detail="No messages provided")

    # Use the last user message as the prompt
    user_messages = [msg for msg in body.messages if msg.role == "user"]
    if not user_messages:
        raise HTTPException(status_code=400, detail="No user message found")

    message = user_messages[-1].content
    print(f"DEBUG: Using message: {message[:50]}...", flush=True)

    # Prepare Cohere API request
    cohere_payload = {
        "model": body.model,
        "message": message,
        "temperature": body.temperature or 0.7,
        "max_tokens": body.max_tokens or 1000,
    }

    # Remove None values
    cohere_payload = {k: v for k, v in cohere_payload.items() if v is not None}

    headers = {
        "Authorization": f"Bearer {cohere_key}",
        "Content-Type": "application/json",
        "Accept": "application/json"
    }

    try:
        async with httpx.AsyncClient() as client:
            print(f"DEBUG: Making API call to Cohere with payload: {cohere_payload}", flush=True)
            response = await client.post(
                "https://api.cohere.ai/v1/chat",
                json=cohere_payload,
                headers=headers,
                timeout=60.0
            )
            print(f"DEBUG: Response status: {response.status_code}", flush=True)
            print(f"DEBUG: Response text: {response.text[:200]}", flush=True)

            if response.status_code != 200:
                error_text = response.text
                logger.error(f"Cohere API error: {response.status_code} - {error_text}")
                raise HTTPException(status_code=500, detail=f"Cohere API error: {error_text}")

            cohere_response = response.json()
            print(f"DEBUG: Parsed JSON response: {cohere_response}", flush=True)

            # Convert Cohere response to OpenAI format
            return {
                "id": cohere_response.get("response_id", f"chatcmpl-{hash(str(cohere_payload))}"),
                "object": "chat.completion",
                "created": int(datetime.utcnow().timestamp()),
                "model": body.model,
                "choices": [{
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": cohere_response.get("text", "")
                    },
                    "finish_reason": cohere_response.get("finish_reason", "stop").lower()
                }],
                "usage": {
                    "prompt_tokens": cohere_response.get("meta", {}).get("tokens", {}).get("input_tokens", 0),
                    "completion_tokens": cohere_response.get("meta", {}).get("tokens", {}).get("output_tokens", 0),
                    "total_tokens": cohere_response.get("meta", {}).get("tokens", {}).get("input_tokens", 0) + cohere_response.get("meta", {}).get("tokens", {}).get("output_tokens", 0)
                }
            }

    except httpx.RequestError as e:
        logger.error(f"Cohere API request error: {e}")
        raise HTTPException(status_code=500, detail=f"Cohere API request error: {str(e)}")


