redis_client = None

def _get_pacific_date_key() -> str:
    """
    Get today's date in Pacific timezone for quota reset at midnight PT.
    Returns key format: "YYYY-MM-DD" in Pacific time.
    """
    pacific = pytz.timezone('America/Los_Angeles')
    today_pt = datetime.now(pacific).strftime("%Y-%m-%d")
    return today_pt


async def track_quota(model: str, tokens: int = 0) -> Dict[str, Any]:
    """
    Track API call quota for a model.
    Returns quota status with calls_today, tokens_today, quota_remaining, etc.
    """
    if not redis_client:
        return {"status": "tracking_disabled"}
    
    if model not in GOOGLE_LIMITS:
        return {"status": "no_limits_defined"}
    
    today_key = _get_pacific_date_key()
    calls_key = f"quota:calls:{model}:{today_key}"
    tokens_key = f"quota:tokens:{model}:{today_key}"
    
    # Increment counters
    calls = await redis_client.incr(calls_key)
    token_total = await redis_client.incrby(tokens_key, tokens)
    
    # Set expiry to midnight PT tomorrow
    if calls == 1:
        await redis_client.expire(calls_key, 86400 + 3600)
        await redis_client.expire(tokens_key, 86400 + 3600)
    
    limits = GOOGLE_LIMITS[model]
    rpd_limit = limits.get("rpd", 1000000)
    quota_remaining = max(0, rpd_limit - calls)
    
    return {
        "calls_today": calls,
        "tokens_today": token_total,
        "quota_remaining": quota_remaining,
        "quota_limit": rpd_limit,
        "reset_time": "midnight PT"
    }


async def check_rate_limits(model: str) -> bool:
    """
    Check if model has quota remaining today (Pacific timezone).
    Returns True if OK to proceed, False if quota exceeded.
    Uses Pacific timezone for daily reset at midnight PT.
    """
    if not redis_client:
        return True  # Allow if Redis unavailable

    if model not in GOOGLE_LIMITS:
        return True  # Allow if no limits defined for this model

    limits = GOOGLE_LIMITS[model]
    rpd_limit = limits.get("rpd", 0)
    
    if rpd_limit <= 0:
        return True  # No daily limit configured
    # Use Pacific timezone for consistent daily reset
    today_key = _get_pacific_date_key()
    calls_key = f"quota:calls:{model}:{today_key}"
    
    # RPD Check
    current_usage = int(await redis_client.get(calls_key) or 0)
    if current_usage >= rpd_limit:
        logger.warning(f"❌ QUOTA EXCEEDED: {model} has reached daily limit ({current_usage}/{rpd_limit})")
        return False

    # RPM Check (New)
    rpm_limit = limits.get("RPM", limits.get("rpm", 0))
    if rpm_limit > 0:
        import time
        minute_key = int(time.time() // 60)
        rpm_key = f"quota:rpm:{model}:{minute_key}"
        
        # Atomically increment and expire
        current_rpm = await redis_client.incr(rpm_key)
        if current_rpm == 1:
            await redis_client.expire(rpm_key, 65) # Expire slightly after minute
            
        if current_rpm > rpm_limit:
             logger.warning(f"❌ RPM Limit Exceeded for {model}: {current_rpm}/{rpm_limit}")
             return False
    
    remaining = rpd_limit - current_usage
    
    if remaining <= (rpd_limit * 0.1) and remaining > 0:
        logger.warning(f"⚠️ QUOTA ALERT: {model} has {remaining} requests remaining today ({current_usage}/{rpd_limit})")
    
    return True

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan manager"""
    global redis_client

    # Startup
    logger.info("Starting ARCA LLM Gateway Service...")

    # Initialize Redis for caching and rate limiting
    redis_url = os.getenv("REDIS_URL", "redis://localhost:6379")
    try:
        redis_client = redis.from_url(redis_url)
        await redis_client.ping()
        logger.info("Connected to Redis")

        # Initialize limiter with Redis storage
        app.state.limiter = limiter
        app.state.limiter.storage_uri = redis_url

    except Exception as e:
        logger.warning(f"Redis connection failed: {e}")
        redis_client = None
        # Fallback to memory storage for rate limiting
        app.state.limiter = Limiter(key_func=get_remote_address)

    # Configure LiteLLM
    litellm.set_verbose = os.getenv("LITELLM_VERBOSE", "false").lower() == "true"

    # Set API keys from environment
    litellm.openai_key = os.getenv("OPENAI_API_KEY")
    litellm.anthropic_key = os.getenv("ANTHROPIC_API_KEY")
    litellm.google_key = os.getenv("GOOGLE_API_KEY")
    litellm.cohere_key = os.getenv("COHERE_API_KEY")
    litellm.openrouter_key = os.getenv("OPENROUTER_API_KEY")

    yield

    # Shutdown
    if redis_client:
        await redis_client.close()
    logger.info("ARCA LLM Gateway Service stopped")

# Create FastAPI app
app = FastAPI(
    title="ARCA LLM Gateway",
    description="Unified API gateway for multiple LLM providers",
    version="1.0.0",
    lifespan=lifespan
)

