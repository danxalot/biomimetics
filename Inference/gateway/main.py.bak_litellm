# ==================== COMPREHENSIVE ERROR LOGGING SYSTEM ====================
# This system captures all errors for auditing and self-improvement capabilities

import traceback
import uuid

class ErrorAuditLogger:
    """Comprehensive error logging and auditing system"""
    
    def __init__(self, log_dir=None):
        if log_dir is None:
            # Check for /app (Docker) vs Local
            if os.path.exists("/app"):
                log_dir = "/app/shared_storage/logs"
            else:
                log_dir = os.path.join(os.getcwd(), "logs")
        
        self.log_dir = log_dir
        self.error_dir = os.path.join(log_dir, "errors")
        
        try:
            os.makedirs(self.error_dir, exist_ok=True)
        except OSError:
            # Fallback for permission errors
            self.log_dir = "/tmp/arca_logs"
            self.error_dir = os.path.join(self.log_dir, "errors")
            os.makedirs(self.error_dir, exist_ok=True)
            
        self.error_summary_path = os.path.join(self.error_dir, "error_summary.jsonl")
        
    def log_error(self, error_id: str, error_type: str, error_message: str, 
                  context: Dict[str, Any], request_data: Optional[Dict] = None, 
                  response_data: Optional[Dict] = None, stack_trace: Optional[str] = None):
        """
        Log error with full context for auditing and self-improvement
        
        Args:
            error_id: Unique identifier for this error
            error_type: Type of error (e.g., 'APIError', 'ValidationError', 'QuotaError')
            error_message: Human-readable error message
            context: Additional context dict (model, endpoint, etc)
            request_data: The raw request that caused the error
            response_data: The raw response (if available)
            stack_trace: Full stack trace for debugging
        """
        timestamp = datetime.now(timezone.utc).isoformat()
        
        error_record = {
            "timestamp": timestamp,
            "error_id": error_id,
            "error_type": error_type,
            "error_message": error_message,
            "context": context,
            "request": request_data,
            "response": response_data,
            "stack_trace": stack_trace
        }
        
        # Save detailed error file
        error_file = os.path.join(self.error_dir, f"error_{error_id}.json")
        try:
            with open(error_file, 'w') as f:
                json.dump(error_record, f, indent=2, default=str)
        except Exception as e:
            logger.error(f"Failed to write error file {error_file}: {e}")
        
        # Append to error summary (JSONL format for streaming analysis)
        try:
            with open(self.error_summary_path, 'a') as f:
                f.write(json.dumps(error_record, default=str) + '\n')
        except Exception as e:
            logger.error(f"Failed to append to error summary: {e}")
        
        # Terminal alert (formatted for easy spotting)
        alert_msg = (
            f"\n{'='*70}\n"
            f"❌ ERROR DETECTED (ID: {error_id})\n"
            f"{'='*70}\n"
            f"Type:    {error_type}\n"
            f"Message: {error_message}\n"
            f"Time:    {timestamp}\n"
            f"Model:   {context.get('model', 'N/A')}\n"
            f"Details: {context.get('endpoint', 'N/A')}\n"
            f"Audit:   {error_file}\n"
            f"{'='*70}\n"
        )
        logger.error(alert_msg)
        
        return error_record

# Initialize error logger
error_logger = ErrorAuditLogger()

# Load secrets from mounted directory
SECRETS_DIR = os.environ.get("SECRETS_DIR", "/app/secrets")

def load_secret(secret_name: str, env_var_name: str):
    """Load a secret from file and set as environment variable"""
    # Respect existing environment variables (e.g. from .env)
    if os.environ.get(env_var_name):
        # logger.info(f"{env_var_name} already set in environment")
        return

    secret_path = os.path.join(SECRETS_DIR, secret_name)
    if os.path.exists(secret_path):
        try:
            with open(secret_path, 'r') as f:
                content = f.read().strip()
                # Handle JSON secrets if needed
                if content.startswith('{') and content.endswith('}'):
                    try:
                        data = json.loads(content)
                        value = data.get(env_var_name) or data.get("api_key") or content
                    except json.JSONDecodeError:
                        value = content
                else:
                    value = content
                
                if value:
                    os.environ[env_var_name] = str(value)
                    logger.info(f"Loaded secret for {env_var_name}")
        except Exception as e:
            logger.error(f"Failed to load secret {secret_name}: {e}")

