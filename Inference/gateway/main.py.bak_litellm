# PASSTHROUGH FUNCTION REMOVED - Using native LiteLLM for all Google models
# The passthrough had architectural issues causing safety blocks
# Direct google.generativeai API calls work, but routing through gateway failed
# Native LiteLLM is the clean solution
#
# async def handle_google_gemini_passthrough(body: ChatCompletionRequest, request: Request, retry_with_model: Optional[str] = None):
#     ... (310 lines removed)
#     pass

    """
    Passthrough handler for Google Gemini models.
    Forwards requests directly to Google's generativeai API.
    
    On 429 (quota exceeded) error:
    - Returns 429 with available models + quotas for HITL model selection
    - Does NOT automatically fallback (requires human decision)
    - Agents can use HITL MCP tool to get model recommendations
    """
    try:
        import google.generativeai as genai
        
        # Configure API key
        api_key = os.getenv("GOOGLE_API_KEY")
        if not api_key:
            raise HTTPException(status_code=400, detail="GOOGLE_API_KEY not configured")
        
        genai.configure(api_key=api_key)
        
        # Get model (use alias if available)
        model_config = MODEL_CONFIGS.get(retry_with_model or body.model, {})
        actual_model = model_config.get("model_alias", retry_with_model or body.model)
        
        # Convert messages to Gemini format
        chat_history = []
        system_instruction = None
        
        for msg in body.messages:
            if msg.role == "system":
                system_instruction = msg.content
            elif msg.role == "user":
                chat_history.append({"role": "user", "parts": [{"text": msg.content}]})
            elif msg.role == "assistant":
                chat_history.append({"role": "model", "parts": [{"text": msg.content}]})
        
        # Initialize model
        model = genai.GenerativeModel(actual_model)
        
        # Log detailed debug info
        logger.info(f"📋 DEBUG: Gemini API call details:")
        logger.info(f"   Model: {actual_model}")
        logger.info(f"   System instruction: {'YES' if system_instruction else 'NO'}")
        logger.info(f"   Chat history length: {len(chat_history)}")
        logger.info(f"   Temperature: {body.temperature}, Max tokens: {body.max_tokens}")
        
        # Get the main user message for both branches
        user_message = None
        for msg in body.messages:
            if msg.role == "user":
                user_message = msg.content
                break
        
        if not user_message:
            raise HTTPException(status_code=400, detail="No user message provided")
        
        # Choose appropriate API method based on model type and system instruction
        if system_instruction:
            # Gemma models don't support system_instruction parameter
            # Detect at runtime to handle any fallback scenarios (Gemini↔Gemma)
            if actual_model.startswith('gemma'):
                logger.info(f"Gemma model detected: {actual_model}")
                logger.info(f"Using prepend method (Gemma doesn't support system_instruction parameter)")
                logger.info(f"   User message: '{user_message[:100]}...'")
                
                # Combined system + user for older models
                combined_message = f"{system_instruction}\n\n{user_message}"
                
                # Create model WITHOUT system instruction parameter
                model = genai.GenerativeModel(actual_model)
                
                # Disable safety filters - allow legitimate philosophical/AI content
                safety_settings = {
                    genai.types.HarmCategory.HARM_CATEGORY_HATE_SPEECH: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_HARASSMENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                }
                
                response = await asyncio.to_thread(
                    model.generate_content,
                    combined_message,
                    generation_config=genai.types.GenerationConfig(
                        temperature=body.temperature,
                        max_output_tokens=body.max_tokens
                    ),
                    safety_settings=safety_settings
                )
            else:
                # Gemini models support system_instruction parameter
                logger.info(f"Gemini model detected: {actual_model}")
                logger.info(f"Using system_instruction parameter")
                logger.info(f"   User message: '{user_message[:100]}...'")
                
                # Disable safety filters - allow legitimate philosophical/AI content
                safety_settings = {
                    genai.types.HarmCategory.HARM_CATEGORY_HATE_SPEECH: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_HARASSMENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                    genai.types.HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                }
                
                # Create model with system instruction and call generate_content
                model_with_system = genai.GenerativeModel(actual_model, system_instruction=system_instruction)
                response = await asyncio.to_thread(
                    model_with_system.generate_content,
                    user_message,
                    generation_config=genai.types.GenerationConfig(
                        temperature=body.temperature,
                        max_output_tokens=body.max_tokens
                    ),
                    safety_settings=safety_settings
                )
        else:
            # Use chat session for multi-turn conversation without system instruction
            logger.info(f"Using chat session (no system instruction)")
            
            # Get last user message (should be same as user_message for single turn)
            last_message = chat_history[-1]["parts"][0]["text"] if chat_history else user_message
            
            logger.info(f"   Message being sent: '{last_message[:100]}...'")
            
            # Disable safety filters - allow legitimate philosophical/AI content
            safety_settings = {
                genai.types.HarmCategory.HARM_CATEGORY_HATE_SPEECH: genai.types.HarmBlockThreshold.BLOCK_NONE,
                genai.types.HarmCategory.HARM_CATEGORY_HARASSMENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                genai.types.HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT: genai.types.HarmBlockThreshold.BLOCK_NONE,
                genai.types.HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT: genai.types.HarmBlockThreshold.BLOCK_NONE,
            }
            
            # Start chat session
            chat = model.start_chat(history=chat_history[:-1] if len(chat_history) > 1 else [])
            
            # Call Gemini API with safety settings
            response = await asyncio.to_thread(
                chat.send_message,
                last_message,
                generation_config=genai.types.GenerationConfig(
                    temperature=body.temperature,
                    max_output_tokens=body.max_tokens
                ),
                safety_settings=safety_settings
            )
        
        # Track quota usage (use user_message for consistent variable reference)
        estimated_tokens = len(user_message) // 4
        quota_status = await track_quota(actual_model, estimated_tokens)
        logger.info(f"Quota tracked for {actual_model}: {quota_status}")
        
        # Extract text safely - treat empty response as error
        if not response.parts or len(response.parts) == 0:
            logger.error(f"Google Gemini {actual_model} returned empty response (no parts)")
            if hasattr(response, 'prompt_feedback'):
                logger.error(f"Prompt feedback: {response.prompt_feedback}")
            logger.error(f"📋 Response object attributes: {dir(response)}")
            logger.error(f"📋 Full response object: {response}")
            raise HTTPException(status_code=503, detail="Model returned no content - possible safety block or API issue")
        
        response_text = response.text
        if not response_text or response_text.strip() == "":
            logger.error(f"Google Gemini {actual_model} returned response with empty text content")
            raise HTTPException(status_code=503, detail="Model returned empty text content")
        
        logger.info(f"✅ Google Gemini response received ({len(response_text)} chars)")
        
        # Log successful request/response for audit trail
        request_id = str(uuid.uuid4())[:8]
        audit_dir = os.path.join("/app/shared_storage/logs", "audit_trail")
        os.makedirs(audit_dir, exist_ok=True)
        
        try:
            audit_record = {
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "request_id": request_id,
                "model": body.model,
                "status": "success",
                "request": {
                    "model": body.model,
                    "messages": [{"role": m.role, "content_length": len(m.content)} for m in body.messages],
                    "temperature": body.temperature,
                    "max_tokens": body.max_tokens
                },
                "response": {
                    "content_length": len(response_text),
                    "content_preview": response_text[:200],
                    "usage": {
                        "estimated_prompt_tokens": len(user_message) // 4,
                        "estimated_completion_tokens": len(response_text) // 4
                    }
                }
            }
            audit_file = os.path.join(audit_dir, f"request_{request_id}.json")
            with open(audit_file, 'w') as f:
                json.dump(audit_record, f, indent=2, default=str)
        except Exception as audit_err:
            logger.warning(f"Failed to log audit trail: {audit_err}")
        
        # Convert to OpenAI format
        return {
            "id": f"gemini-{hash(str(body.messages))}",
            "object": "chat.completion",
            "created": int(datetime.utcnow().timestamp()),
            "model": retry_with_model or body.model,
            "choices": [{
                "index": 0,
                "message": {
                    "role": "assistant",
                    "content": response_text
                },
                "finish_reason": "stop"
            }],
            "usage": {
                "prompt_tokens": 0,  # Gemini doesn't expose token counts easily
                "completion_tokens": 0,
                "total_tokens": 0
            }
        }
        
    except Exception as e:
        error_detail = str(e)
        error_id = str(uuid.uuid4())[:8]
        
        # Log comprehensive error record
        error_logger.log_error(
            error_id=error_id,
            error_type=type(e).__name__,
            error_message=error_detail,
            context={
                "model": body.model,
                "endpoint": "/v1/chat/completions",
                "provider": "google_gemini",
                "message_count": len(body.messages)
            },
            request_data={
                "model": body.model,
                "messages_preview": [{"role": m.role, "content_length": len(m.content)} for m in body.messages],
                "temperature": body.temperature,
                "max_tokens": body.max_tokens
            },
            response_data=None,
            stack_trace=traceback.format_exc()
        )
        
        logger.error(f"Google Gemini API error: {error_detail}")
        
        # Check for 429 (quota exceeded) - trigger HITL instead of auto-fallback
        if "429" in error_detail or "quota" in error_detail.lower():
            logger.warning(f"⚠️ QUOTA EXCEEDED (429): {body.model}")
            logger.info("Triggering HITL (Human-In-The-Loop) for model selection...")
            
            # Fetch current quota status to include in response
            if redis_client:
                try:
                    today_key = _get_pacific_date_key()
                    available_models = {}
                    
                    for model_name in GOOGLE_LIMITS.keys():
                        calls_key = f"quota:calls:{model_name}:{today_key}"
                        calls = int(await redis_client.get(calls_key) or 0)
                        limits = GOOGLE_LIMITS[model_name]
                        limit = limits.get("rpd", 1000000)
                        remaining = max(0, limit - calls)
                        
                        available_models[model_name] = {
                            "calls_today": calls,
                            "quota_limit": limit,
                            "quota_remaining": remaining,
                            "quota_percentage_used": round((calls / limit) * 100, 2) if limit > 0 else 0
                        }
                    
                    # Return 429 with HITL context (NOT automatic fallback)
                    raise HTTPException(
                        status_code=429,
                        detail={
                            "error": "QUOTA_EXCEEDED_REQUIRES_HITL",
                            "message": f"Quota exceeded for {body.model}. Human selection required.",
                            "failed_model": body.model,
                            "instruction": "Use HITL MCP tool to select alternative model",
                            "available_models": available_models,
                            "hitl_tool": "mcp_hitl_model_selection",
                            "reset_time": "midnight PT"
                        }
                    )
                except HTTPException:
                    raise
                except Exception as hitl_err:
                    logger.warning(f"Failed to prepare HITL response: {hitl_err}")
            
            # Fallback if Redis unavailable
            raise HTTPException(
                status_code=429,
                detail={
                    "error": "QUOTA_EXCEEDED_REQUIRES_HITL",
                    "message": f"Quota exceeded for {body.model}. Human selection required.",
                    "failed_model": body.model,
                    "instruction": "Use HITL MCP tool to select alternative model",
                    "hitl_tool": "mcp_hitl_model_selection",
                    "reset_time": "midnight PT"
                }
            )
        
        if "API key" in error_detail:
            raise HTTPException(status_code=401, detail="Google API key invalid or missing")
        elif "401" in error_detail:
            raise HTTPException(status_code=401, detail="Google API authentication failed")
        else:
            raise HTTPException(status_code=500, detail=f"Google Gemini error: {error_detail}")


async def handle_mock_response(body: ChatCompletionRequest, request: Request, mock_data: Dict[str, Any]):
    """
    Mock response handler that injects a recorded response without calling the API.
    Used for testing gateway logic with known responses.
    
    Args:
        body: Chat completion request
        request: FastAPI request
        mock_data: Dictionary containing mocked response data
                   {"text": "...", "usage_prompt": 123, "usage_completion": 456}
    """
    request_id = str(uuid.uuid4())[:8]
    timestamp = datetime.now(timezone.utc).isoformat()
    
    audit_dir = os.path.join("/app/logs", "mock_responses")
    os.makedirs(audit_dir, exist_ok=True)
    
    # Log incoming request
    request_record = {
        "timestamp": timestamp,
        "request_id": request_id,
        "type": "mock_test",
        "model": body.model,
        "messages": [
            {
                "role": msg.role,
                "content_length": len(msg.content),
                "content_preview": msg.content[:100]
            }
            for msg in body.messages
        ],
        "parameters": {
            "temperature": body.temperature,
            "max_tokens": body.max_tokens
        }
    }
    
    request_file = os.path.join(audit_dir, f"request_{request_id}.json")
    with open(request_file, 'w') as f:
        json.dump(request_record, f, indent=2, default=str)
    
    # Log mock response being returned
    response_record = {
        "timestamp": timestamp,
        "request_id": request_id,
        "type": "mock_response",
        "model": body.model,
        "response": {
            "content": mock_data.get("text", ""),
            "content_length": len(mock_data.get("text", "")),
            "usage": {
                "prompt_tokens": mock_data.get("usage_prompt", 0),
                "completion_tokens": mock_data.get("usage_completion", 0),
                "total_tokens": mock_data.get("usage_prompt", 0) + mock_data.get("usage_completion", 0)
            }
        }
    }
    
    response_file = os.path.join(audit_dir, f"response_{request_id}.json")
    with open(response_file, 'w') as f:
        json.dump(response_record, f, indent=2, default=str)
    
    # Terminal notification
    logger.info(
        f"\n{'='*70}\n"
        f"🧪 MOCK RESPONSE TEST (ID: {request_id})\n"
        f"{'='*70}\n"
        f"Model:    {body.model}\n"
        f"Response: {mock_data.get('text', '')[:80]}...\n"
        f"Audit:    {audit_dir}/\n"
        f"{'='*70}\n"
    )
    
    # Return OpenAI format response with mock data
    return {
        "id": f"mock-{request_id}",
        "object": "chat.completion",
        "created": int(datetime.utcnow().timestamp()),
        "model": body.model,
        "choices": [{
            "index": 0,
            "message": {
                "role": "assistant",
                "content": mock_data.get("text", "")
            },
            "finish_reason": "stop"
        }],
        "usage": {
            "prompt_tokens": mock_data.get("usage_prompt", 0),
            "completion_tokens": mock_data.get("usage_completion", 0),
            "total_tokens": mock_data.get("usage_prompt", 0) + mock_data.get("usage_completion", 0)
        }
    }


@app.post("/chat/completions")
@app.post("/v1/chat/completions")
async def chat_completion(body: ChatCompletionRequest, request: Request):
    """Unified chat completion endpoint with quota tracking and 429 fallback"""
    try:
        # Check custom rate limits (Daily/Hard, Pacific timezone reset at midnight) - only if Redis available
        # Check custom rate limits with Rotation Logic
        if rate_limiting_enabled:
             # This will rotate body.model to the next available one if quota exceeded
             # or raise 429 if all exhausted.
             body.model = await resolve_model_with_rotation(body.model)

        # Ensure API keys are set
        if not litellm.cohere_key:
            litellm.cohere_key = os.getenv("COHERE_API_KEY")
        if not litellm.openai_key:
            litellm.openai_key = os.getenv("OPENAI_API_KEY")
        if not litellm.anthropic_key:
            litellm.anthropic_key = os.getenv("ANTHROPIC_API_KEY")
        if not litellm.google_key:
            litellm.google_key = os.getenv("GOOGLE_API_KEY")

        # Validate model
        if body.model not in MODEL_CONFIGS:
            raise HTTPException(status_code=400, detail=f"Model {body.model} not supported")

        # Get model config
        model_config = MODEL_CONFIGS[body.model]

        # Debug model - logs requests/responses to files without calling API
        if body.model == "debug-model" or body.model.startswith("debug-"):
            return await handle_debug_model(body, request)

        # PASSTHROUGH REMOVED - All models including Google use native LiteLLM
        # Google models will be prefixed with gemini/ for proper routing

        # Special handling for Cohere models (direct API calls)
        if model_config["provider"] == "cohere":
            return await handle_cohere_chat_completion(body, request)

        # Convert messages to LiteLLM format
        messages = [{"role": msg.role, "content": msg.content} for msg in body.messages]

        
        # Determine actual model name (use alias if provided)
        actual_model = model_config.get("model_alias", body.model)
        
        # Provider-specific routing and model name formatting
        provider = model_config.get("provider")
        
        # Google: prefix with gemini/
        if provider == "google" and not actual_model.startswith("gemini/"):
            actual_model = f"gemini/{actual_model}"
            
        # Local/native handlers as per V2 design
        elif provider == "local" or provider == "llamacpp":
            # Ensure model name is clean
            actual_model = actual_model.replace("ollama_chat/", "").replace("ollama/", "")
            
        # BigModel (GLM/Zhipu): Use OpenAI compatible endpoint
        elif provider == "bigmodel" or provider == "zhipu":
            # Zhipu endpoint for OpenAI compatibility
            actual_model = actual_model.replace("zhipu/", "")
            
            # GLOBAL TOKEN QUOTA CHECK FOR BIGMODEL (10M Tokens)
            # Check shared quota limit
            if redis_client:
                global_quota_key = "arca:quota:global:bigmodel:tokens"
                current_usage = int(await redis_client.get(global_quota_key) or 0)
                GLOBAL_LIMIT = 10_000_000
                
                if current_usage >= GLOBAL_LIMIT:
                    logger.warning(f"⚠️ GLOBAL BIGMODEL QUOTA EXCEEDED ({current_usage}/{GLOBAL_LIMIT})")
                    raise HTTPException(status_code=429, detail="Global BigModel token quota exceeded (10M limit).")

        
        # Prepare LiteLLM parameters
        params = {
            "model": actual_model,
            "messages": messages,
            "temperature": body.temperature,
            "max_tokens": body.max_tokens,
            "stream": body.stream,
            "user": body.user,
        }
        
        # Add api_base for providers using OpenAI format
        
        # Add api_base for providers using OpenAI format
        if provider == "bigmodel" or provider == "zhipu":
            # Zhipu/GLM endpoint (OpenAI compatible)
            params["model"] = f"openai/{actual_model}"
            params["api_base"] = "https://open.bigmodel.cn/api/paas/v4/"
            
            # Use specific ZHIPU_API_KEY
            api_key = os.getenv("ZHIPU_API_KEY") or os.getenv("BIGMODEL_API_KEY")
            params["api_key"] = api_key
            
            if api_key:
                params["extra_headers"] = {"Authorization": f"Bearer {api_key}"}
        
        # Add api_base for local models
        elif "api_base" in model_config:
            params["api_base"] = model_config["api_base"]
            # For local OpenAI-compatible endpoints
            params["model"] = f"openai/{actual_model}"
            params["api_key"] = "not-needed"  # Local models don't need API key

        # Remove None values
        params = {k: v for k, v in params.items() if v is not None}

        if  body.model == "google":
                 pass # Placeholder to preserve structure if needed

        # Log request
        logger.info(f"Processing request for model {body.model} from {get_remote_address(request)}")

        # Make the completion call
        # Add extended timeout for local models which can be slow on CPU
        if provider == "local":
            params["request_timeout"] = 600 # 10 minutes
        else:
            params["request_timeout"] = 120 # 2 minutes for cloud models

        try:
            # Call LiteLLM
            if body.stream:
                return await acompletion(**params)
            else:
                response = await acompletion(**params)

            # Cost tracking logic would go here

            # Log response
            logger.info(f"Completed request for model {body.model}")

            # Helper to safely access response fields (LiteLLM returns different types per provider)
            def safe_get(obj, *keys, default=None):
                """Safely get nested attributes, dict keys, or list indices"""
                for key in keys:
                    if obj is None:
                        return default
                    # Handle list/tuple access with integer indices
                    if isinstance(key, int):
                        if isinstance(obj, (list, tuple)) and len(obj) > key:
                            obj = obj[key]
                        else:
                            return default
                    # Handle dict access
                    elif isinstance(obj, dict):
                        obj = obj.get(key, default)
                    # Handle object attribute access
                    else:
                        obj = getattr(obj, key, default)
                return obj if obj is not None else default

            # Extract content - handle both object and dict access
            message_obj = safe_get(response, 'choices', 0, 'message') or {}
            content = safe_get(message_obj, 'content', default='') or (message_obj.get('content') if isinstance(message_obj, dict) else getattr(message_obj, 'content', ''))

            # Track usage for Global BigModel Quota
            usage_tokens = safe_get(response, 'usage', 'total_tokens', default=0)
            if provider in ["bigmodel", "zhipu"] and redis_client and usage_tokens > 0:
                try:
                    global_quota_key = "arca:quota:global:bigmodel:tokens"
                    await redis_client.incrby(global_quota_key, usage_tokens)
                    logger.info(f"Checked in {usage_tokens} tokens to Global BigModel Quota")
                except Exception as e:
                    logger.error(f"Failed to update global quota: {e}")
            
            # Return response in OpenAI-compatible format
            return {
                "id": safe_get(response, 'id', default="chatcmpl-" + str(hash(str(params)))),
                "object": "chat.completion",
                "created": int(datetime.utcnow().timestamp()),
                "model": body.model,
                "choices": [{
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": content
                    },
                    "finish_reason": safe_get(response, 'choices', 0, 'finish_reason', default="stop")
                }],
                "usage": {
                    "prompt_tokens": safe_get(response, 'usage', 'prompt_tokens', default=0),
                    "completion_tokens": safe_get(response, 'completion_tokens', default=0),
                    "total_tokens": safe_get(response, 'usage', 'total_tokens', default=0),
                }
            }

        except Exception as e:
            import traceback
            error_details = {
                "error_type": type(e).__name__,
                "error_message": str(e),
                "traceback": traceback.format_exc()
            }
            logger.error(f"Error processing chat completion: {error_details}")
            print(f"DEBUG: Full error details: {error_details}", flush=True)
            raise HTTPException(status_code=500, detail=f"{type(e).__name__}: {str(e)}")

    except Exception as e:
        import traceback
        error_trace = traceback.format_exc()
        logger.error(f"Error processing request: {str(e)}\nTraceback:\n{error_trace}")
        raise HTTPException(status_code=500, detail=str(e))

        # Log response
        logger.info(f"Completed request for model {body.model}")

        # Helper to safely access response fields (LiteLLM returns different types per provider)
        def safe_get(obj, *keys, default=None):
            """Safely get nested attributes, dict keys, or list indices"""
            for key in keys:
                if obj is None:
                    return default
                # Handle list/tuple access with integer indices
                if isinstance(key, int):
                    if isinstance(obj, (list, tuple)) and len(obj) > key:
                        obj = obj[key]
                    else:
                        return default
                # Handle dict access
                elif isinstance(obj, dict):
                    obj = obj.get(key, default)
                # Handle object attribute access
                else:
                    obj = getattr(obj, key, default)
            return obj if obj is not None else default

        # Extract content - handle both object and dict access
        message_obj = safe_get(response, 'choices', 0, 'message') or {}
        content = safe_get(message_obj, 'content', default='') or (message_obj.get('content') if isinstance(message_obj, dict) else getattr(message_obj, 'content', ''))

        # Track usage for Global BigModel Quota
        usage_tokens = safe_get(response, 'usage', 'total_tokens', default=0)
        if provider in ["bigmodel", "zhipu"] and redis_client and usage_tokens > 0:
            try:
                global_quota_key = "arca:quota:global:bigmodel:tokens"
                await redis_client.incrby(global_quota_key, usage_tokens)
                logger.info(f"Checked in {usage_tokens} tokens to Global BigModel Quota")
            except Exception as e:
                logger.error(f"Failed to update global quota: {e}")
        
        # Return response in OpenAI-compatible format
        return {
            "id": safe_get(response, 'id', default="chatcmpl-" + str(hash(str(params)))),
            "object": "chat.completion",
            "created": int(datetime.utcnow().timestamp()),
            "model": body.model,
            "choices": [{
                "index": 0,
                "message": {
                    "role": "assistant",
                    "content": content
                },
                "finish_reason": safe_get(response, 'choices', 0, 'finish_reason', default="stop")
            }],
            "usage": {
                "prompt_tokens": safe_get(response, 'usage', 'prompt_tokens', default=0),
                "completion_tokens": safe_get(response, 'usage', 'completion_tokens', default=0),
                "total_tokens": safe_get(response, 'usage', 'total_tokens', default=0),
            }
        }

    except Exception as e:
        import traceback
        error_details = {
            "error_type": type(e).__name__,
            "error_message": str(e),
            "traceback": traceback.format_exc()
        }
        logger.error(f"Error processing chat completion: {error_details}")
        print(f"DEBUG: Full error details: {error_details}", flush=True)
        raise HTTPException(status_code=500, detail=f"{type(e).__name__}: {str(e)}")

@app.get("/usage")
async def get_usage():
    """Get quota usage statistics for all models today (Pacific timezone)"""
    if not redis_client:
        return {"status": "tracking_disabled", "message": "Redis not available"}
    
    today_key = _get_pacific_date_key()
    usage_data = {}
    
    for model in GOOGLE_LIMITS.keys():
        calls_key = f"quota:calls:{model}:{today_key}"
        tokens_key = f"quota:tokens:{model}:{today_key}"
        
        calls = int(await redis_client.get(calls_key) or 0)
        tokens = int(await redis_client.get(tokens_key) or 0)
        limits = GOOGLE_LIMITS[model]
        limit = limits.get("rpd", 1000000)
        
        usage_data[model] = {
            "calls_today": calls,
            "tokens_today": tokens,
            "quota_limit": limit,
            "quota_remaining": max(0, limit - calls),
            "date": today_key,
            "reset": "midnight PT"
        }
    
    return {"today_pt": today_key, "usage": usage_data}

@app.get("/usage/{model}")
async def get_model_usage(model: str):
    """Get quota usage for a specific model today"""
    if not redis_client:
        return {"status": "tracking_disabled"}
    
    if model not in GOOGLE_LIMITS:
        raise HTTPException(status_code=404, detail=f"Model {model} not found in limits")
    
    today_key = _get_pacific_date_key()
    calls_key = f"quota:calls:{model}:{today_key}"
    tokens_key = f"quota:tokens:{model}:{today_key}"
    
    calls = int(await redis_client.get(calls_key) or 0)
    tokens = int(await redis_client.get(tokens_key) or 0)
    limits = GOOGLE_LIMITS[model]
    limit = limits.get("rpd", 1000000)
    
    return {
        "model": model,
        "date": today_key,
        "calls_today": calls,
        "tokens_today": tokens,
        "quota_limit": limit,
        "quota_remaining": max(0, limit - calls),
        "quota_percentage_used": round((calls / limit) * 100, 2) if limit > 0 else 0,
        "reset": "midnight PT"
    }


@app.get("/hitl/available-models")
async def get_available_models_for_hitl():
    """
    HITL (Human-In-The-Loop) Endpoint
    
    Returns available models with their current quota status.
    Used by agents to show humans which models are available when 429 occurs.
    
    Agents call this endpoint to get:
    - List of all available models
    - Current quota for each model
    - Recommendation for best fallback
    
    Response:
    {
        "timestamp": "2025-12-19T15:30:45",
        "today_pt": "2025-12-19",
        "models": [
            {
                "model_name": "gemini-2.5-flash",
                "calls_today": 120,
                "quota_remaining": 880,
                "quota_limit": 1000,
                "quota_percentage_used": 12.0,
                "status": "available"
            },
            ...
        ],
        "best_available": "gemini-2.5-flash",
        "recommendations": [
            "✅ gemini-2.5-flash: 880/1000 remaining (12.0% used)",
            "✅ gemini-2.5-flash-lite: 950/1000 remaining (5.0% used)",
        ],
        "hitl_required": true,
        "hitl_tool": "mcp_hitl_model_selection"
    }
    """
    if not redis_client:
        raise HTTPException(status_code=503, detail="Redis not available")
    
    today_key = _get_pacific_date_key()
    models_list = []
    recommendations = []
    
    for model in GOOGLE_LIMITS.keys():
        calls_key = f"quota:calls:{model}:{today_key}"
        calls = int(await redis_client.get(calls_key) or 0)
        limits = GOOGLE_LIMITS[model]
        limit = limits.get("rpd", 1000000)
        remaining = max(0, limit - calls)
        pct_used = (calls / limit * 100) if limit > 0 else 0
        
        # Determine status
        if remaining <= 0:
            status = "exhausted"
        elif pct_used >= 80:
            status = "low"
        else:
            status = "available"
        
        models_list.append({
            "model_name": model,
            "calls_today": calls,
            "quota_remaining": remaining,
            "quota_limit": limit,
            "quota_percentage_used": round(pct_used, 2),
            "status": status
        })
        
        # Generate recommendation line
        status_emoji = {"available": "✅", "low": "⚠️", "exhausted": "❌"}.get(status, "❓")
        recommendations.append(
            f"{status_emoji} {model}: {remaining}/{limit} remaining ({pct_used:.1f}% used)"
        )
    
    # Sort by available quota (descending)
    models_list.sort(key=lambda x: x["quota_remaining"], reverse=True)
    
    # Find best available
    available = [m for m in models_list if m["status"] != "exhausted"]
    best_available = available[0]["model_name"] if available else None
    
    return {
        "timestamp": datetime.utcnow().isoformat(),
        "today_pt": today_key,
        "models": models_list,
        "best_available": best_available,
        "recommendations": recommendations,
        "hitl_required": True,
        "hitl_tool": "mcp_hitl_model_selection",
        "reset_time": "midnight PT"
    }


# ==================== TEST ENDPOINTS ====================

@app.post("/v1/test/mock-response")
async def test_mock_response(body: ChatCompletionRequest, request: Request):
    """
    Test endpoint that injects a mock Gemini response without calling the API.
    Simulates the exact format that google.generativeai returns.
    
    This allows testing of the gateway's response handling logic with
    known/controlled data without burning API quota.
    
    Request: Standard chat completion request
    Response: Uses recorded real response data
    """
    # Use the exact response format from a successful gemini-pro-latest call
    mock_data = {
        "text": "============================================================\nTesting: gemini-pro-latest\n============================================================\nWARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nE0000 00:00:1766113952.951087 5349049 alts_credentials.cc:93] ALTS creds ignored. Not running on GCP and untrusted ALTS is not enabled.\n✅ SUCCESS\n   Latency: 6.94s\n   Response length: 54 chars\n   Content: Hello, I am a large language model, trained by Google.",
        "usage_prompt": 8,
        "usage_completion": 54
    }
    
    return await handle_mock_response(body, request, mock_data)


@app.post("/v1/embeddings", response_model=EmbeddingResponse)
async def create_embedding(request: EmbeddingRequest, raw_request: Request):
    """
    Generate embeddings using the specified model
    """
    request_id = str(uuid.uuid4())
    logger.info(f"📝 Embedding request {request_id} for model {request.model}")

    try:
        # Check rate limits
        if rate_limiting_enabled:
            key = f"rate_limit:{request.model}:{get_remote_address(raw_request)}"
            # Simple check - could be expanded to token tracking if needed
            
        # Map model aliases if needed
        model_name = request.model
        
        # Call LiteLLM
        response = await litellm.aembedding(
            model=model_name,
            input=request.input,
            user=request.user,
            dimensions=request.dimensions
        )
        
        return response.model_dump()

    except Exception as e:
        error_logger.log_error(
            error_id=request_id,
            error_type=type(e).__name__,
            error_message=str(e),
            context={
                "model": request.model,
                "endpoint": "/v1/embeddings"
            },
            request_data=request.dict(),
            stack_trace=traceback.format_exc()
        )
        raise HTTPException(status_code=500, detail=str(e))

