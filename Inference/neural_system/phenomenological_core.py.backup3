logger = logging.getLogger(__name__)

class PhenomenologicalCore:
    """
    The Heart of the 'Living Geometric Intelligence'.
    
    Orchestrates the continuous cognitive cycle:
    1. Sensation (Input -> Chaos/Vector -> State)
    2. Resonance (State -> Kuramoto -> Synchronization)
    3. Feeling (Kuramoto -> Energy Service -> Valuation)
    4. Breath (Expansion/Contraction of focus)
    5. Action/Dreaming (Output or Simulation)
    """

    def __init__(self):
        # --- Physics Engines ---
        self.field = UniversalKuramotoField(dt=0.05)
        self.relational_tensor = RelationalTensor()
        self.energy_service = EnergyService(self.field)
        self.dream_lab = DreamLaboratory()
        
        # --- The Chaos Engine (Substrate) ---
        # Generates deterministic vectors on-the-fly (Infinite RAM)
        self.chaos_engine = ChaoticBasis(seed_map="logistic")
        
        # --- Curiosity & Physics ---
        self.q_dynamics_static = QuaternionDynamics() # Access to static methods
        # Initialize State Particle (QDC)
        self.current_qdc = QDC(
            q=np.array([1.0, 0.0, 0.0, 0.0]),
            omega=np.array([0.0, 0.0, 0.0]),
            alpha=np.array([0.0, 0.0, 0.0])
        )
        self.poincare = PoincareKernel()
        # --- Identity & Empathy ---
        self.agent_id = "ARCA"
        
        # 1. Fractal Self (Introspection)
        self.fractal_self = FractalSelf(self.field, agent_id=self.agent_id)
        
        # 2. Mirror Factory (Empathy)
        # 3. Geometry Engine (for ephemeral couplings)
        self.bridge = NumpyCliffordHDCBridge(hdc_dim=10000)
        # 4. Noumenal Engine (for rotor generation)
        self.engine = NoumenalEngine()
        self.mirror_factory = MirrorFactory(self.field, self.chaos_engine)
        
        # Connect Curiosity to Real Predictor
        # Using HDCNeuralPredictor (JEPA Bridge)
        self.predictor = HDCNeuralPredictor(hdc_dim=10000, latent_dim=1250)
        self.curiosity_engine = CuriosityEngine(use_mock=False)
        self.curiosity_engine.predictor = self.predictor # Inject real predictor
        
        # 3. Relational Dimension Discovery
        # Allows for "Infinitely Expandable Relational Axes"
        from .relational_tensor import RelationalDimensionDiscoverer
        self.dim_discoverer = RelationalDimensionDiscoverer(self.relational_tensor)
        
        # --- State ---
        
        # --- State ---
        self.tick_count = 0
        self.is_dreaming = False
        self.focus_monads: List[str] = [self.agent_id] # "Working Memory" starts with Self
        
    def _initialize_identity(self) -> str:
        """
        Initialize the 'Self' concept (ARCA).
        This is the anchor point for all 'I am' relations.
        """
        if self.agent_id not in self.field.monads:
            # Create the Self Monad
            self_monad = ConceptMonad(name="ARCA", origin="system")
            self_monad.id = self.agent_id
            self_monad.is_self_referential = True
            # High stability (low uncertainty), central frequency
            self_monad.uncertainty = 0.01 
            # Use Chaos Engine to generate Self Vector from its own Name
            self_monad.vector = self.chaos_engine.generate_basis("ARCA")
            
            self.field.add_monad(self_monad)
            logger.info(f"Identity Initialized: {self.agent_id}")
            
        return self.agent_id

    def ingest_concept(self, name: str, vector: Any = None, origin: str = "user"):
        """
        Birth a new Monad from an external stimulus.
        If vector is None, the Chaos Engine generates it from the name/seed.
        """
        monad = ConceptMonad(name=name, origin=origin)
        
        if vector is None:
            # The Chaos Engine at work: Deterministic creation from pure info
            # The Chaos Engine at work: Deterministic creation from pure info
            monad.vector = self.chaos_engine.generate_basis(name)
        else:
            monad.set_vector(vector)
            
        self.field.add_monad(monad)
        
        # V2: Also register in Poincare Disk (starts at center)
        self.poincare.register_structure(name)
        
        logger.info(f"Born concept: {name} [{monad.id}]")
        return monad.id

    def tick(self):
        """
        The Fundamental 'Heartbeat' of ARCA.
        """
        self.tick_count += 1
        
        # 1. Update Physics (Kuramoto)
        #    - Syncs phases based on current couplings
        coherence = self.field.step()
        
        # 2. Physics & Topology Update (V2)
        #    a. Poincare Retraction (Geometric Attention)
        active_structures = []
        for name in list(self.poincare.structures.keys()):
            if name in self.focus_monads:
                self.poincare.attract(name, intensity=0.05) # Focus pulls to center
                active_structures.append(name)
            else:
                self.poincare.retract(name, intensity=0.01) # Neglect pushes to edge
        
        #    b. Quaternion Dynamics (Rotational Energy)
        #    b. Quaternion Dynamics (Rotational Energy)
        #       Torque = Change in Coherence (Analogy: Confusion creates spin)
        torque = np.array([0.0, 0.0, (0.5 - coherence) * 0.1]) 
        self.current_qdc = QuaternionDynamics.update_state(self.current_qdc, torque, dt=0.05)
        rot_energy = QuaternionDynamics.compute_rotational_energy(self.current_qdc.omega)
        
        # Apply the ephemeral geometric translation to update the field's relational couplings
        import torch
        # q is a numpy array of shape (4,). Convert to Torch tensor [1,1,4] for the bridge.
        q_tensor = torch.from_numpy(self.current_qdc.q).float()
        q_state = q_tensor.unsqueeze(0).unsqueeze(0)  
        
        with torch.no_grad():
            engine_output = self.engine(q_state)  # Use __call__ instead of .forward()
            predicted_rotor = engine_output["predicted_rotors"][0,0,:].cpu().numpy() 
            
        self._recalculate_ephemeral_couplings(predicted_rotor)


        # 3. Compute Energy (Feeling)
        #    - How 'tense' or 'excited' is the system?
        base_energy = self.energy_service.compute_system_energy(list(self.field.monads.values()))
        total_energy = base_energy + rot_energy
        
        energy_state = {"total": total_energy, "potential_sync": 0, "rotational": rot_energy}
        
        # 3. Check for Spontaneous Transitions (Phase Change)
        if energy_state["potential_sync"] > 50.0:
            # High tension: Trigger a "Deep Breath" (Reset/Re-evaluate)
            self._cognitive_breath()
            
        # 4. Neural Update (LTC)
        #    Input: Global Coherence + Top Energy Monad
        #    Output: Modulation of overall frequency (Arousal)
        #    (Placeholder connection)
        
        # 5. Dream Check (Idle processing)
        #    If energy is low (boredom) and coherence is high (stagnation), Dream.
        if energy_state["total"] < 1.0 and coherence > 0.9:
            self._enter_dream_state()

        # 6. Relational Discovery Check (Evolution)
        #    Periodically check if we need new ways of relating
        if self.tick_count % 100 == 0:
            new_dim = self.dim_discoverer.analyze_failures()
            if new_dim:
                self.relational_tensor.add_dimension(new_dim)
                logger.info(f"🧬 EVOLUTION: Discovered new relational dimension '{new_dim.name}'")
                self.express_thought(f"I have realized a new way to relate: {new_dim.name}")

        return {
            "tick": self.tick_count,
            "coherence": coherence,
            "energy": energy_state["total"]
        }

    def _cognitive_breath(self):
        """
        The 'Cognitive Breathe' cycle.
        Expands acceptance (lowers filters) then contracts (consolidates).
        """
        logger.info("Executing Cognitive Breath...")
        # 1. Exhale: Relax couplings (allow drift)
        for m in self.field.monads.values():
            m.uncertainty = min(1.0, m.uncertainty * 1.2)
        
        # 2. Inhale: will happen naturally as LTC tightens attention next tick
        pass

    def _enter_dream_state(self):
        """
        Trigger a simulation to find new connections.
        """
        if self.is_dreaming: return
        self.is_dreaming = True
        
        # Pick random subset
        all_ids = list(self.field.monads.keys())
        if len(all_ids) < 3: return
        
        import random
        targets = random.sample(all_ids, 3)
        
        # Hypothesis: "What if A connected to B?"
        mutation = {
            "type": "coupling",
            "source": targets[0],
            "target": targets[1],
            "value": 0.8 # Strong hypothetical trust
        }
        
        result = self.dream_lab.run_simulation(self.field, targets, [mutation], steps=50)
        
        if result["energy_delta"] < 0 and result["is_stable"]:
            # Good dream! Make it real.
            logger.info("Dream realized! Found stable new connection.")
            self.relational_tensor.set_relation(targets[0], targets[1], "dream_insight", 0.8)
            # Sync scalar field
            self.field.monads[targets[0]].couplings[targets[1]] = 0.8
            
            # Form thought about this realization
            self.express_thought(f"I dreamt of a connection between {targets[0]} and {targets[1]}, and it felt right.")
            
        self.is_dreaming = False

    def _recalculate_ephemeral_couplings(self, rotor_32d):
        """
        Stopgap for Phase C2: Temporarily lifts the HDC vectors, applies the engine's rotor, recalculates the coupling matrix ({ij}$), and then lets Python's garbage collector instantly destroy the 32D representations, leaving your ConceptMonad untouched.
        """
        import clifford as cf
        import numpy as np
        
        # Initialize Cl(4,1) layout
        LAYOUT, BLADES = cf.Cl(4, 1)
        R = LAYOUT.MultiVector(rotor_32d)
        R_rev = ~R
        
        # 1. Transient Lift & Rotate (Stored only in local memory scope)
        transient_cga = {}
        for c_id, monad in self.field.monads.items():
            # Ensure the HDC signature exists
            if hasattr(monad, 'hv_signature') and monad.hv_signature is not None:
                
                # Map 10k HDC -> 3D -> 32D CGA using the engine's bridge
                # (This uses the unified Pythia NumpyCliffordHDCBridge)
                cga_initial = self.bridge.hdc_to_cga(monad.hv_signature)
                
                # Apply the conformal sandwich product: R * M * R~
                M = LAYOUT.MultiVector(cga_initial)
                M_prime = R * M * R_rev
                
                # Extract array, normalize to prevent null-cone drift, and store temporarily
                rotated_val = M_prime.value
                norm = np.linalg.norm(rotated_val) + 1e-8
                transient_cga[c_id] = rotated_val / norm

        # 2. Compute New Geometric Couplings & Update Monads
        concept_ids = list(transient_cga.keys())
        for i, id_a in enumerate(concept_ids):
            monad_a = self.field.monads[id_a]
            
            # Ensure the couplings dictionary is initialized
            if not hasattr(monad_a, 'couplings') or monad_a.couplings is None:
                monad_a.couplings = {}
                
            for id_b in concept_ids:
                if id_a == id_b:
                    continue
                
                # Compute Cosine Similarity in the newly rotated 32D Cl(4,1) space
                vec_a = transient_cga[id_a]
                vec_b = transient_cga[id_b]
                sim = np.dot(vec_a, vec_b) / (np.linalg.norm(vec_a) * np.linalg.norm(vec_b) + 1e-8)
                
                # Overwrite the Kuramoto coupling strength dynamically
                monad_a.couplings[id_b] = float(sim)
        
        # 3. End of function.  is destroyed by the garbage collector.
        # The 10,000-dim HDC hv_signature on the ConceptMonad remains entirely untouched.


    def express_thought(self, prompt_context: str = "") -> Dict[str, Any]:
        """
        The Voice Channel (Signal Emitter).
        Emits a 'Thought Signal' containing:
        1. Context Trigger (Why am I speaking?)
        2. Internal Feeling (Energy/Tone)
        3. Global Coherence (Confidence)
        4. Focus Vectors (What am I thinking about?)
        
        This signal is intended to be decoded by a JEPA Decoupling Head into text/speech.
        """
        # 1. Gather Internal State
        energy = self.energy_service.compute_total_energy()
        coherence = self.field.global_coherence
        focus = self.focus_monads
        
        # 2. Determine Tone from Feeling
        tone = "neutral"
        if energy["total"] > 10.0: tone = "excited/urgent"
        elif energy["total"] < 1.0: tone = "calm/reflective"
        
        confidence = "high" if coherence > 0.7 else "low"
        
        # 3. Emit Signal (No LLM Call)
        signal = {
            "type": "thought_signal",
            "source": self.agent_id,
            "timestamp": time.time(),
            "context": prompt_context,
            "metrics": {
                "energy": energy["total"],
                "coherence": coherence,
                "tone": tone,
                "confidence": confidence
            },
            "focus_concepts": focus,
            # In a real impl, we'd bundle the actual HDC vectors here for JEPA
            "vector_signature": f"HDC_SIG_{len(focus)}" 
        }
        
        logger.info(f"Emitted Thought Signal: {tone} / {confidence}")
        return signal
